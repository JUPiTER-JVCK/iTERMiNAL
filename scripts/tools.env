# Third-party tools bundled inside iTERMiNAL.app, and the only place their
# versions live. Sourced by fetch-superfile.sh, build-btop.sh and CI.
#
# Moving a version is a PR that edits this file. Nothing here updates on its
# own, and nothing is fetched at runtime.

# superfile (https://github.com/yorukot/superfile) — MIT.
# Upstream publishes macOS binaries for both architectures, so these are
# downloaded rather than built. Each hash was computed from the downloaded
# tarball AND matched against upstream's superfile-v<ver>-checksums.txt when
# pinned; a mismatch at build time means the file changed, not that the pin
# is stale, and must fail rather than be updated blindly.
SUPERFILE_VERSION=1.6.0
SUPERFILE_SHA256_ARM64=131f654e7f8366fd37dbe9363739f8d82e57ff3f632f45963cd233c049cfad2a
SUPERFILE_SHA256_AMD64=c08544196ff21fc415ae7cffc800d8400914af647e44eb2613968c09d5868d90

# btop (https://github.com/aristocratos/btop) — Apache-2.0.
# Upstream ships no macOS binaries ("No MacOs or BSD binaries provided"), so
# CI builds it from source. Pinned by commit, not by a hash of GitHub's source
# archive: GitHub has changed archive compression before and invalidated every
# such hash at once. BTOP_COMMIT is what the annotated tag v$BTOP_VERSION
# peels to.
BTOP_VERSION=1.4.7
BTOP_COMMIT=6e39144aaf5a6bc01b9f795010b0914431067183

# Symbols Nerd Font Mono (https://github.com/ryanoasis/nerd-fonts) — MIT for
# the font, with each icon set's own licence listed in the README that ships
# beside it. Not a tool but the same kind of pin: the terminal falls back to it
# for the icons superfile, prompts and ls replacements draw, so they render
# whichever font the user picked. Hash of NerdFontsSymbolsOnly.tar.xz, computed
# from the download and matched against the digest GitHub lists for the asset.
NERD_FONTS_VERSION=3.5.1
NERD_FONTS_SYMBOLS_SHA256=01172f37db8543edb102e5cb5c64101c9f4686630804d49b419aa07b23a69996
