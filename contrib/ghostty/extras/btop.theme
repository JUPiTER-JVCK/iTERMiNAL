# Everforest Dark — btop theme
#
# Generated for the iterminal-everforest-dark palette by contrib/ghostty/export-themes.py --extras.
# Install to ~/.config/btop/themes/iterminal.theme and set
# `color_theme = "iterminal"` in ~/.config/btop/btop.conf, or pick it from
# Esc -> Options -> Color theme.
#
# Each box gets its own accent so the panels read as separate cards rather
# than one grey grid.

theme[main_bg]="#2d353b"
theme[main_fg]="#d3c6aa"
theme[title]="#d3c6aa"
theme[hi_fg]="#a7c080"
theme[selected_bg]="#414648"
theme[selected_fg]="#dbbc7f"
theme[inactive_fg]="#5c6a72"
theme[graph_text]="#888578"
theme[meter_bg]="#414648"
theme[proc_misc]="#83c092"

# Box borders — one accent each.
theme[cpu_box]="#a7c080"
theme[mem_box]="#7fbbb3"
theme[net_box]="#d699b6"
theme[proc_box]="#e09d80"
theme[div_line]="#414648"

# Temperature: green -> yellow -> red.
theme[temp_start]="#a7c080"
theme[temp_mid]="#dbbc7f"
theme[temp_end]="#e67e80"

# CPU load.
theme[cpu_start]="#a7c080"
theme[cpu_mid]="#dbbc7f"
theme[cpu_end]="#e67e80"

# Memory: free, cached, available, used.
theme[free_start]="#e67e80"
theme[free_mid]="#dbbc7f"
theme[free_end]="#a7c080"
theme[cached_start]="#7fbbb3"
theme[cached_mid]="#83c092"
theme[cached_end]="#a7c080"
theme[available_start]="#e67e80"
theme[available_mid]="#dbbc7f"
theme[available_end]="#a7c080"
theme[used_start]="#a7c080"
theme[used_mid]="#dbbc7f"
theme[used_end]="#e67e80"

# Network throughput.
theme[download_start]="#a7c080"
theme[download_mid]="#83c092"
theme[download_end]="#7fbbb3"
theme[upload_start]="#dbbc7f"
theme[upload_mid]="#e09d80"
theme[upload_end]="#e67e80"

# Process list CPU column.
theme[process_start]="#a7c080"
theme[process_mid]="#dbbc7f"
theme[process_end]="#e67e80"
